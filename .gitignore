# ---- Secrets and local configuration ----
# Never commit real credentials. Copy server/.env.example to server/.env and
# fill in your own MongoDB URI and JWT secret.
.env
.env.*
!.env.example
server/.env

# ---- Runtime data ----
# Uploaded logos and product images are user data, not source. The server
# creates this directory on start.
server/uploads/
uploads/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

