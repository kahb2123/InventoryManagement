# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# MongoDB Atlas (SRV)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/buildstock_ethiopia?authSource=admin&retryWrites=true&w=majority
# Local MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/buildstock_ethiopia

# Fallback: spin up an ephemeral in-memory MongoDB when MONGO_URI is unreachable.
# Set to false in production so the API fails loudly instead of losing data.
USE_MEMORY_DB_FALLBACK=false

# ---- Auth ----
# CHANGE THIS in production (minimum 32 characters)
JWT_SECRET=replace-this-with-a-long-random-secret-key-for-jwt-signing
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# ---- Business defaults (seed only; runtime values live in Settings) ----
DEFAULT_CURRENCY=ETB
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Africa/Addis_Ababa

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development convenience: accept any localhost/127.0.0.1 port, so Vite still
# works when it falls back to 5174, 4173, ... Set to false in production.
CORS_ALLOW_LOOPBACK=true

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# ---- Seed credentials ----
SEED_OWNER_EMAIL=owner@buildstock.et
SEED_OWNER_PASSWORD=BuildStock@2024
SEED_OWNER_NAME=BuildStock Owner
